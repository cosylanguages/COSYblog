ont-size:0.85rem; font-weight:500;\">🌐 BA</a> <a href=\"top-10-verbs-pt.html\" style=\"padding:0.4rem 0.75rem; background:#ffffff; border:1px solid #cbd5e1; color:#1e293b; border-radius:6px; text-decoration:none; font-size:0.85rem; font-weight:500;\">🇵🇹 PT</a> <a href=\"top-10-verbs-es.html\" style=\"padding:0.4rem 0.75rem; background:#ffffff; border:1px solid #cbd5e1; color:#1e293b; border-radius:6px; text-decoration:none; font-size:0.85rem; font-weight:500;\">🇪🇸 ES</a> <a href=\"top-10-verbs-de.html\" style=\"padding:0.4rem 0.75rem; background:#ffffff; border:1px solid #cbd5e1; color:#1e293b; border-radius:6px; text-decoration:none; font-size:0.85rem; font-weight:500;\">🇩🇪 DE</a> <a href=\"top-10-verbs-hy.html\" style=\"padding:0.4rem 0.75rem; background:#ffffff; border:1px solid #cbd5e1; color:#1e293b; border-radius:6px; text-decoration:none; font-size:0.85rem; font-weight:500;\">🇦🇲 HY</a> <a href=\"top-10-verbs-ka.html\" style=\"padding:0.4rem 0.75rem; background:#ffffff; border:1px solid #cbd5e1; color:#1e293b; border-radius:6px; text-decoration:none; font-size:0.85rem; font-weight:500;\">🇬🇪 KA</a> <a href=\"top-10-verbs-cv.html\" style=\"padding:0.4rem 0.75rem; background:#ffffff; border:1px solid #cbd5e1; color:#1e293b; border-radius:6px; text-decoration:none; font-size:0.85rem; font-weight:500;\">🌐 CV</a>\n    </div>\n</div>"
