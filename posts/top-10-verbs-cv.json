      "text": "<div style=\"margin: 1rem 0 2rem 0; padding: 1rem; background: #f8fafc; border-radius: 10px; border: 1px solid #e2e8f0;\">\n    <div style=\"font-size:0.9rem; font-weight:bold; color:#475569; margin-bottom:0.6rem;\">🌐 Урăх 14 чĕлхе гидне куçасси:</div>\n    <div style=\"display:flex; flex-wrap:wrap; gap:0.5rem;\">\n        <a href=\"top-10-verbs.html\" style=\"padding:0.4rem 0.75rem; background:#3b82f6; color:#ffffff; border-radius:6px; text-decoration:none; font-size:0.85rem; font-weight:bold;\">🏛 Hub</a> <a href=\"top-10-verbs-en.html\" style=\"padding:0.4rem 0.75rem; background:#ffffff; border:1px solid #cbd5e1; color:#1e293b; border-radius:6px; text-decoration:none; font-size:0.85rem; font-weight:500;\">🇬🇧 EN</a> <a href=\"top-10-verbs-fr.html\" style=\"padding:0.4rem 0.75rem; background:#ffffff; border:1px solid #cbd5e1; color:#1e293b; border-radius:6px; text-decoration:none; font-size:0.85rem; font-weight:500;\">🇫🇷 FR</a> <a href=\"top-10-verbs-it.html\" style=\"padding:0.4rem 0.75rem; background:#ffffff; border:1px solid #cbd5e1; color:#1e293b; border-radius:6px; text-decoration:none; font-size:0.85rem; font-weight:500;\">🇮🇹 IT</a> <a href=\"top-10-verbs-ru.html\" style=\"padding:0.4rem 0.75rem; background:#ffffff; border:1px solid #cbd5e1; color:#1e293b; border-radius:6px; text-decoration:none; font-size:0.85rem; font-weight:500;\">🇷🇺 RU</a> <a href=\"top-10-verbs-el.html\" style=\"padding:0.4rem 0.75rem; background:#ffffff; border:1px solid #cbd5e1; color:#1e293b; border-radius:6px; text-decoration:none; font-size:0.85rem; font-weight:500;\">🇬🇷 EL</a> <a href=\"top-10-verbs-tt.html\" style=\"padding:0.4rem 0.75rem; background:#ffffff; border:1px solid #cbd5e1; color:#1e293b; border-radius:6px; text-decoration:none; font-size:0.85rem; font-weight:500;\">🌐 TT</a> <a href=\"top-10-verbs-ba.html\" style=\"padding:0.4rem 0.75rem; background:#ffffff; border:1px solid #cbd5e1; color:#1e293b; border-radius:6px; text-decoration:none; font-size:0.85rem